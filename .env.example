# Rummy Backend — local development defaults
# Copy to .env and adjust only for local overrides. Never commit .env.

# Postgres (local Docker)
POSTGRES_DB=nakama
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdb
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433

# Nakama — API / gRPC / Console
NAKAMA_API_PORT=7350
NAKAMA_GRPC_PORT=7349
NAKAMA_CONSOLE_PORT=7351

# Nakama console credentials (local only — change for production)
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=password

# Nakama runtime / session
NAKAMA_HTTP_KEY=defaulthttpkey
NAKAMA_SESSION_ENCRYPTION_KEY=defaultencryptionkey
NAKAMA_SOCKET_SERVER_KEY=defaultkey

# Compose project name — isolates volumes/networks from other local stacks (e.g. tinybot on 5432/8080)
COMPOSE_PROJECT_NAME=rummy_backend
